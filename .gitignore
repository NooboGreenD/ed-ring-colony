# Dependencies
node_modules/

# Build artifacts
dist/
build/
target/
.next/

# TypeScript/JavaScript build outputs
*.js.map
*.d.ts
*.d.ts.map
*.tsbuildinfo

# Temporary files
*.tmp
*.swp
*.swo
# Бандлы, которые scripts/tests/system-map-hover.test.mjs собирает внутри репо
# (react помечен external, поэтому бандл обязан видеть node_modules).
.tmp-edmap-*/
# Временные папки тестов интерфейса карты (сборка компонента в jsdom).
.tmp-*/
*.html
supabase/.temp/

# Logs
*.log

# Environment variables
.env
.env.local
*.env.*
# Keep the safe, placeholder-only setup template in the distribution.
!.env.example

# IDE specific
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
*.coverage

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
.venv/

# Заглушка `requests` для локального прогона uploader-тестов без pip
.teststub/

# Собранный архив дистрибутива (создаётся ./deploy/make-dist.sh)
dist-archive/

# Local verification and deployment scratch files
.cache/

# Запасной Dockerfile web без кэш-маунтов (deploy/compose-lib.sh,
# edrc_prepare_legacy_build): генерируется при сборке без BuildKit.
.edrc-legacy-Dockerfile

# Spansh dump download + generated points file (scripts/import-spansh-systems.mjs)
data/spansh/
public/data/*
# Справочник верфи собирается скриптом, но нужен в поставке: без него страница
# /outfitting пустая, а пересобрать его на боевом сервере нечем.
!public/data/outfitting.json
# Пакеты обновлений Colonial Helper при локальном запуске сервера
# (на боевом сервере это том /data/uploader).
data/uploader/
# Сборочные артефакты пакета: манифест, архив версии, встроенная копия.
uploader/dist/
uploader/build/
