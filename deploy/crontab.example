# LEGACY ALTERNATIVE ONLY. Docker deployment already has the `jobs` service.
# Do NOT run this in parallel with jobs, systemd or the old GitHub schedules.
# There is deliberately no secret in crontab: put it in a mode-0600 env file.
# Requires Node.js >=22.18 for the repository tests; scheduler itself needs Node 22.
# Example for a non-Docker installation (paths/user adjusted by the operator):
# JOBS_BASE_URL=http://127.0.0.1:3000 must be in /opt/ed-ring-colony/.env.production.
# Create /opt/ed-ring-colony/jobs owned by the crontab user (mode 0700).
# flock serializes each manual cron job; failure output must be collected by cron mail/logging.
# Schedule timezone is the server's timezone; set the host to UTC for the calendar below.
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

*/5 * * * * flock -n /opt/ed-ring-colony/jobs/capi.lock node --env-file=/opt/ed-ring-colony/.env.production /opt/ed-ring-colony/src/scripts/server-jobs.mjs --once capi-sync
*/30 * * * * flock -n /opt/ed-ring-colony/jobs/progress.lock node --env-file=/opt/ed-ring-colony/.env.production /opt/ed-ring-colony/src/scripts/server-jobs.mjs --once update-progress
0 */6 * * * flock -n /opt/ed-ring-colony/jobs/cg.lock node --env-file=/opt/ed-ring-colony/.env.production /opt/ed-ring-colony/src/scripts/server-jobs.mjs --once cg-check
30 */6 * * * flock -n /opt/ed-ring-colony/jobs/eddn.lock node --env-file=/opt/ed-ring-colony/.env.production /opt/ed-ring-colony/src/scripts/server-jobs.mjs --once eddn-cleanup
20 6 * * * flock -n /opt/ed-ring-colony/jobs/translation.lock node --env-file=/opt/ed-ring-colony/.env.production /opt/ed-ring-colony/src/scripts/server-jobs.mjs --once galnet-sync
40 */6 * * * flock -n /opt/ed-ring-colony/jobs/translation.lock node --env-file=/opt/ed-ring-colony/.env.production /opt/ed-ring-colony/src/scripts/server-jobs.mjs --once translate
