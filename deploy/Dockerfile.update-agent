# ═════════════════════════════════════════════════════════════════════
# ED Ring Colony — приватный апдейтер проекта (Админка → Мониторинг)
#
# Единственный контейнер, которому разрешено менять развёрнутую версию:
# он запускает deploy/update-project.sh (git fetch/merge, миграции, сборка,
# `docker compose up -d --build`). В сервисе `web` ни git, ни Docker-сокета
# нет и не будет — запрос админа приходит сюда по внутренней сети Compose
# с отдельным Bearer-токеном.
#
# Запуск опциональным профилем monitoring:
#   docker compose --env-file .env.production --profile monitoring up -d update-agent
# или одной командой: sudo bash deploy/start-update-agent.sh --docker
#
# Репозиторий монтируется в контейнер ПО ТЕМУ ЖЕ пути, что и на хосте: сборка
# передаёт контекст докер-демону, а демон смотрит на пути хоста.
# ═════════════════════════════════════════════════════════════════════
FROM node:22-alpine

# git — сам апдейт; docker-cli(+compose) — пересборка стека; docker-cli-buildx
# — BuildKit для compose build: без плагина compose уходит в legacy-билдер и
# падает на «the --mount option requires BuildKit» из Dockerfile web;
# postgresql-client — бэкап и миграции, если база не в контейнере;
# curl — проверка живости после переключения.
#
# Если CDN Alpine на секунду не разрешился через DNS, `apk` пишет вводящее в
# заблуждение `bash (no such package)`: на самом деле не загрузился APKINDEX.
# Повторяем именно сетевой шаг, чтобы из-за краткого сбоя не приходилось заново
# запускать всю (на медленном VPS — долгую) Compose-сборку.
# Каталог смонтирован с хоста: его владелец ≠ uid контейнера, поэтому после
# установки разрешаем Git работать с явно примонтированным репозиторием.
RUN set -eux; \
  for attempt in 1 2 3 4 5; do \
    if apk add --no-cache bash git curl docker-cli docker-cli-compose docker-cli-buildx postgresql-client; then \
      break; \
    fi; \
    if [ "$attempt" = 5 ]; then \
      echo "apk: не удалось скачать индексы/пакеты после $attempt попыток" >&2; \
      exit 1; \
    fi; \
    delay=$((attempt * 5)); \
    echo "apk: временная ошибка сети, повтор через ${delay}с (попытка $((attempt + 1))/5)" >&2; \
    sleep "$delay"; \
  done; \
  git config --system --add safe.directory '*'

WORKDIR /app
COPY scripts/update-agent.mjs ./scripts/
COPY scripts/lib/update-state.mjs ./scripts/lib/
COPY deploy/update-project.sh ./deploy/
COPY deploy/apply-env.sh ./deploy/
COPY deploy/apply-smtp.sh ./deploy/
COPY deploy/update-agent-entrypoint.sh ./deploy/
RUN chmod +x /app/deploy/update-project.sh /app/deploy/apply-env.sh /app/deploy/apply-smtp.sh /app/deploy/update-agent-entrypoint.sh

# UPDATE_SCRIPT по умолчанию = $PROJECT_DIR/deploy/update-project.sh, то есть
# скрипт из обновляемого репозитория (его правки вступают сразу). Копия в
# /app/deploy остаётся запасной для ручного запуска.
ENV NODE_ENV=production \
    UPDATE_AGENT_PORT=8092 \
    UPDATE_AGENT_HOST=0.0.0.0 \
    UPDATE_STATE_DIR=/state \
    DOCKER_CONFIG=/state/.docker \
    UPDATE_HEALTH_URL=http://web:3000/api/health

EXPOSE 8092
# Точка входа выбирает код агента из смонтированного клона, если он там есть.
#
# Foreground update does not recreate this container (it is the process doing
# the update). After the new stack is healthy, update-project.sh starts a small
# detached helper from the old image; that helper recreates update-agent from
# the freshly built image. This matters for image-level packages such as
# docker-cli-buildx: restarting only the Node process cannot install them.
ENTRYPOINT ["/app/deploy/update-agent-entrypoint.sh"]
