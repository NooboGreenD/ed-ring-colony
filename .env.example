# ED Ring Colony — local Supabase configuration template
#
# Copy this file to .env.local and put temporary values only in .env.local.
# .env.local is intentionally ignored by Git; do not commit real credentials.
# Never prefix SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ACCESS_TOKEN, or
# SUPABASE_DB_PASSWORD with NEXT_PUBLIC_.

# Required by the Next.js application (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://sgukfplhxdhmkqponwft.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Публичный адрес сайта (без завершающего слэша). Используется для
# OAuth-редиректов (Discord), ссылок в письмах и т.п. На VPS обязателен —
# без него код падает на дефолт https://ed-ring-colony.vercel.app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only key used by privileged API routes, including support tickets.
# Use the Supabase service_role key, not the anon/publishable key.
SUPABASE_SERVICE_ROLE_KEY=

# Required only when using Supabase CLI to link/push migrations.
# These are not used by the browser application or Vercel runtime.
SUPABASE_PROJECT_REF=sgukfplhxdhmkqponwft
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Optional direct database connection alternative for CLI commands that accept
# --db-url. Leave empty unless you deliberately use a direct connection.
SUPABASE_DB_URL=

# Secret shared by cron jobs (Vercel Cron, GitHub Actions → /api/*).
# Used as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Yandex Cloud Translate API v2 — автоперевод новостей и Galnet.
# Основной вариант — API-ключ сервисного аккаунта.
YANDEX_TRANSLATE_API_KEY=
# Альтернатива API-ключу (например, если используется IAM-токен).
YANDEX_TRANSLATE_IAM_TOKEN=
# Идентификатор каталога Yandex Cloud. Опционален, но обязателен
# при работе с глоссариями и для части аккаунтов.
YANDEX_TRANSLATE_FOLDER_ID=

# ── Frontier CAPI (досье пилота) ─────────────────────────────────────
# Авторизация идёт по PKCE, поэтому Shared Key от FDEV НЕ требуется:
# доказательством служит code_verifier, который знает только тот, кто начал
# авторизацию. Обязателен только redirect_uri.
#
# Полный адрес колбэка сайта, до символа:
FRONTIER_REDIRECT_URI=http://localhost:3000/api/capi/callback
#
# Client ID. Можно оставить пустым — тогда используется client_id
# официального компаньон-приложения Elite Dangerous (публичный клиент без
# секрета, PKCE с ним работает). Свой Client ID создаётся за минуту в
# Developer Zone: https://user.frontierstore.net → «CREATE CLIENT»; тогда
# диалог согласия Frontier покажет имя вашего сервиса.
FRONTIER_CLIENT_ID=
#
# НЕ нужен. Заполняйте только если осознанно используете «конфиденциальный»
# клиент с секретом: PKCE-поток от этого не сломается, но и работать без
# секрета продолжит.
FRONTIER_CLIENT_SECRET=

# ── Web Push (уведомления) ──────────────────────────────────────────
# Пара VAPID-ключей: npx web-push generate-vapid-keys
# Публичный ключ вшивается в клиентский бандл, приватный — только сервер.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контакт владельца (mailto: или https:) для push-сервисов браузеров.
VAPID_SUBJECT=mailto:admin@example.com

# ── EDDN (рыночные данные, опционально) ──────────────────────────────
# Секрет, которым eddn-worker подписывает POST на /api/eddn/ingest.
EDDN_INGEST_SECRET=
# Куда воркер шлёт данные (адрес вашего сайта + /api/eddn/ingest).
EDDN_INGEST_URL=

# ── Прочие интеграции (опционально) ──────────────────────────────────
# Ключ Inara API (статистика пилотов).
INARA_API_KEY=
# Discord-вебхук для уведомлений.
DISCORD_WEBHOOK_URL=
# База Raven Colonial API, если отличается от значения по умолчанию.
RAVEN_API_BASE=

# Galnet sync (scripts/galnet-sync.mjs, GitHub Actions).
# Сколько последних статей забирать из ленты за один запуск.
GALNET_FEED_LIMIT=30
# Сколько статей переводить за один проход (остаток дойдёт следующим).
GALNET_TRANSLATE_LIMIT=10
