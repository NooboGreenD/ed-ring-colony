# ED Ring Colony — local Supabase configuration template
#
# Copy this file to .env.local and put temporary values only in .env.local.
# .env.local is intentionally ignored by Git; do not commit real credentials.
# Never prefix SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ACCESS_TOKEN, or
# SUPABASE_DB_PASSWORD with NEXT_PUBLIC_.

# Required by the Next.js application (Project Settings → API)
# Standard/public setup: direct Supabase domain. If its TLS is broken but the
# main site certificate works, use the same-origin gateway instead (see
# POST-MIGRATION.md → «Аварийный шлюз Supabase без изменения Synology»):
# NEXT_PUBLIC_SUPABASE_URL=https://edringcolony.ru/api/supabase
NEXT_PUBLIC_SUPABASE_URL=https://supabase.edringcolony.ru
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only address of Kong used by the same-origin gateway. It reuses the
# existing site reverse proxy and needs no new Synology port/rule. On the shared
# Supabase Docker network: http://kong:8000; otherwise the existing Docker host
# gateway can reach a locally published Kong: http://host.docker.internal:8000.
# Leave empty when NEXT_PUBLIC_SUPABASE_URL points directly to a healthy HTTPS
# Supabase domain. This value is used at build time too, so rebuild web after
# changing it.
SUPABASE_INTERNAL_URL=

# Публичный адрес сайта (без завершающего слэша). Используется для
# OAuth-редиректов (Discord), ссылок в письмах и т.п. На VPS обязателен —
# Используйте канонический HTTPS-домен; localhost оставьте только для разработки.
NEXT_PUBLIC_SITE_URL=https://edringcolony.ru

# Server-only key used by privileged API routes, including support tickets.
# Use the Supabase service_role key, not the anon/publishable key.
SUPABASE_SERVICE_ROLE_KEY=

# Required only when using Supabase CLI to link/push migrations.
# These are not used by the browser application or Vercel runtime.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Optional direct database connection alternative for CLI commands that accept
# --db-url. Leave empty unless you deliberately use a direct connection.
# The Spansh catalog import and /api/galaxy/all-systems also use it (with
# DATABASE_URL) as the fast direct-Postgres path; without them they fall back
# to PostgREST (NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY).
SUPABASE_DB_URL=
# DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres
#
# HOST must be resolvable from the process that uses it — for the catalog
# import that is the `web` container. `db` is the Supabase service name inside
# ITS compose network and fails from `web` with «getaddrinfo EAI_AGAIN db»;
# deploy/start-monitoring.sh attaches `web` and `monitor-agent` to that
# network automatically (deploy/compose.supabase-net.yml, see SUPABASE_NETWORK
# below). After that the working URL for a self-hosted stack is exactly:
#   postgresql://postgres:POSTGRES_PASSWORD@db:5432/postgres
# (POSTGRES_PASSWORD lives in the Supabase stack .env / deploy credentials
# file). Alternatives: host.docker.internal / a routable IP with the port
# published. Verify without importing:
#   node scripts/import-spansh-systems.mjs --check-db
#   node scripts/apply-galnet-migration.mjs --status
#
# Name of the docker network of the self-hosted Supabase stack. Written by
# deploy/start-monitoring.sh after it detects the stack (default:
# supabase_default — `docker network ls` shows the exact name). Used by
# deploy/compose.supabase-net.yml and, as a hint, by the Supabase network
# watchdog in update-agent; the value is not a secret.
# SUPABASE_NETWORK=supabase_default
#
# Supabase network watchdog (runs inside update-agent, profile `monitoring`).
# Any `docker compose up` executed WITHOUT deploy/compose.supabase-net.yml
# silently recreates `web` outside the Supabase network, and the direct
# Postgres connection («db») breaks until the next start-monitoring.sh run.
# The watchdog re-attaches detached containers live every N seconds and logs
# who recreated them (docker logs <project>-update-agent-1 | grep "сторож").
# 0 disables the watchdog. See MONITORING.md.
# SUPABASE_NET_WATCH_SECONDS=60
# SUPABASE_NET_WATCH_SERVICES=web,monitor-agent

# Optional: direct Postgres URL for the monitor-agent so the panel can show
# the real database size (pg_database_size) from the host side. Needed when
# the `web` container has neither DATABASE_URL nor SUPABASE_DB_URL — for
# example, when Supabase runs on the host outside the Compose network.
# `deploy/start-monitoring.sh` mirrors it from DATABASE_URL / SUPABASE_DB_URL
# automatically; set it manually only if the mirror is wrong. Used by
# monitor-agent exclusively — the value never reaches the browser.
# For a self-hosted stack on the same machine the mirror is the same `db:5432`
# URL — the agent is attached to the Supabase network together with web.
# MONITOR_DB_URL=postgresql://user:PASSWORD@HOST:5432/postgres

# Optional mirror of the Spansh dump for the in-app catalog import
# (Админка → «Каталог систем», /api/cron/galaxy-import).
# Default: https://downloads.spansh.co.uk/systems.json.gz
# GALAXY_IMPORT_URL=https://mirror.example.org/systems.json.gz
#
# Mirror of the whole dump DIRECTORY. The import normally does not download the
# 5.9 GiB systems.json.gz at all: after the first full load it applies the
# rolling deltas Spansh publishes next to it (systems_1day.json.gz ≈ 4 MiB,
# systems_1week ≈ 21 MiB, systems_2weeks ≈ 39 MiB, systems_1month ≈ 88 MiB,
# systems_6months ≈ 617 MiB). Point this at a mirror and the whole ladder moves
# with it. A GALAXY_IMPORT_URL that ends with a known dump file name implies
# the same directory, so usually you need only one of the two.
# GALAXY_DUMP_BASE_URL=https://mirror.example.org/spansh/
#
# Parallel HTTP Range connections for the download (1–16, default 4). One TCP
# stream to downloads.spansh.co.uk measured ~a week for 5.9 GiB on a thin line;
# several ranges multiply that. Per-segment progress is stored next to the
# archive (<file>.parts.json), so a restart continues instead of starting over.
# Set 1 to restore the old single-stream behaviour.
# GALAXY_DOWNLOAD_SEGMENTS=4
#
# How the archive is imported:
#   stream (default) — straight from the .gz, like before;
#   shards           — unpack the archive ONCE into gzipped TSV shards
#                      (<GALAXY_ARCHIVE_DIR>/shards) and import those. Gzip
#                      cannot be decoded from the middle, so a resumed stream
#                      import re-reads and re-parses the whole 6 GiB just to
#                      skip what it already wrote; with shards a restart costs
#                      O(1) (continue at the next file). Shards can also be
#                      copied/rsync'ed to the server one by one.
# GALAXY_IMPORT_MODE=stream
# GALAXY_SHARDS_DIR=/app/data/spansh/shards
# Delete each shard right after it is written to the database (keeps the disk
# at ~archive size instead of archive + shards).
# GALAXY_SHARDS_PRUNE=0
#
# statement_timeout for ONE merge step of the COPY import (staging → catalog),
# in seconds. Default: 0 = NO LIMIT. A merge joins the batch against the WHOLE
# catalog and updates the live GIN/GiST search indexes, so on a loaded catalog
# (2×10⁸ rows) a single step honestly runs for tens of minutes — that is what
# updating the catalog with the weekly archive looks like (a delta keeps the
# indexes). The old 120 s / 900 s guards cancelled exactly that work: the whole
# batch was rolled back and the weekly update never landed. Progress stays
# visible (a heartbeat line every 15 s) and a stuck merge is stopped by hand
# with «Прервать импорт» in the admin panel. Set a whole number of seconds ≥ 1
# here to bring the guard back (e.g. 1800).
# GALAXY_COPY_MERGE_TIMEOUT_S=0

# The in-app catalog import works in two phases: download the ~6 GiB dump to
# disk, then import it from disk. The download is resumable (HTTP Range) and
# retries dropped connections; the import itself never needs the network.
#
# WHERE THE DUMPS LIVE. The catalog data does not belong on the system disk:
# the full archive is 5.9 GiB and its shards another ~5–6 GiB (the raw
# systems.json would be 32+ GiB, which is why the shards are gzipped TSV and
# the raw JSON is never written out). docker-compose bind-mounts this HOST
# directory — a separate disk — at /app/data/spansh:
# GALAXY_DATA_HOST_DIR=/mnt/sdb/ed-ring-colony/spansh
# This is a PATH, not a device: `/dev/sdb1` must be mounted first
# (`findmnt -no TARGET /dev/sdb1` shows where, empty = not mounted).
# The setup/migration script finds the mount point of /dev/sdb1 itself,
# creates the directory, prints the line to paste here and copies the data
# off the old `galaxy-dump` named volume:
#   sudo bash deploy/migrate-galaxy-dump.sh
#   sudo GALAXY_DATA_DEVICE=/dev/sdc1 bash deploy/migrate-galaxy-dump.sh
#
# Directory inside the container (default: data/spansh = the mount above).
# GALAXY_ARCHIVE_DIR=data/spansh
#
# HOUSEKEEPING. Before a new dump is downloaded the previous archives and the
# shards that belong to them are deleted, and after a successful import the
# archive itself is deleted too — the rows are in Postgres and the next
# refresh is a few megabytes of delta. Opt out of the second part with:
# GALAXY_ARCHIVE_KEEP=1
# Keep unpacked shards even when their archive is gone (they are normally
# dropped before the next dump arrives):
# GALAXY_SHARDS_KEEP=1
# A download that obviously does not fit is refused up front, with the
# numbers. Disable that guard (e.g. for an exotic filesystem) with:
# GALAXY_DISK_CHECK=0
#
# Pin a dump already on disk (e.g. brought over manually): the import reads it
# directly and downloads nothing. The file's mtime is the freshness the nightly
# update checks.
# GALAXY_IMPORT_FILE=/app/data/spansh/systems.json.gz
#
# Map point cloud size. The catalog is the whole explored galaxy (~2×10⁸
# systems — EDAstro counts 203.6M), so one point per system would be ~5.5 GiB:
# it would fit neither the `galaxy-data` bucket nor three.js. The cloud is a
# uniform sample instead, and its ceiling is derived, not guessed:
#   min(GALAXY_POINTS_MAX, points that fit in min(bucket file_size_limit, 60 MiB))
# With the 64 MiB bucket of 20261009000000_galaxy_points_scale.sql that is
# 2,000,000 points = 58 MB ≈ 67 bytes per system on the client. 0 disables
# sampling (do not: 2×10⁸ points is not a cloud, it is a stall).
# GALAXY_POINTS_MAX=2000000
#
# Where the built cloud is cached. Defaults to <GALAXY_ARCHIVE_DIR>/points, i.e.
# the Spansh data disk — which is a bind mount, so the file survives container
# rebuilds. /api/galaxy/all-systems serves it first; publishing to Storage is
# what makes it visible to other processes. If Storage refuses a transiently
# (503 while it restarts), the build is NOT lost: the cloud stays here and the
# admin panel offers «Повторить загрузку в storage».
# GALAXY_POINTS_DIR=/app/data/spansh/points
#
# Override the bucket ceiling when the app cannot read `storage.buckets`
# (PostgREST-only setup) or when the bucket limit lives elsewhere. Bytes; the
# effective per-file cap of Supabase Storage is min(this, bucket limit, and on
# self-hosted installs the global FILE_SIZE_LIMIT of the storage service).
# GALAXY_POINTS_BUCKET_BYTES=67108864

# Secret shared by the local jobs container and the web API (at least 32 random characters).
# Used as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Local scheduler. Exactly one instance; disable legacy cron/GitHub schedules.
# Empty JOBS_ENABLED disables all jobs; missing Inara/Yandex keys are logged as skips.
# `galaxy-import` is opt-in: it re-downloads the ~6 GiB Spansh dump nightly and
# refreshes galaxy_systems. Add it to the list to enable, or trigger the import
# manually (Админка → «Каталог систем» / node scripts/server-jobs.mjs --once galaxy-import).
JOBS_ENABLED=capi-sync,update-progress,cg-check,eddn-cleanup,colonisation-cleanup,galnet-sync,translate
JOBS_TRANSLATE_PASSES=4
# Сколько дней истории состояний строек держать в colonisation_events (задача
# colonisation-cleanup). Последний снимок каждой площадки не удаляется никогда —
# он нужен карте Raven. Минимум 7, максимум 3650.
# COLONISATION_RETENTION_DAYS=60
# Docker sets JOBS_BASE_URL=http://web:3000 itself.
# For a non-Docker scheduler only: JOBS_BASE_URL=http://127.0.0.1:3000

# ── Admin operations dashboard (Docker Compose only) ───────────────────
# A separate private monitor-agent reads Docker status and scheduler state; it
# has no host port, and the website calls it only after an admin login.
# Everything below is filled in automatically by `bash deploy/start-monitoring.sh`
# (it generates a distinct token, starts the profile and verifies the chain).
# Manually: openssl rand -hex 32. Leave empty only to disable Docker/jobs
# visibility in Admin → Monitoring.
MONITOR_AGENT_TOKEN=
# Optional deployment metadata shown only to admins; baked into the web image
# and used by the «Версия проекта» block for an exact revision comparison.
# deploy/start-monitoring.sh, selfhost/install.sh and the panel updater write
# them here automatically before every build — an empty value only means the
# image was built by hand without any script. For a manual build either run
# those scripts or fill the three values right before `docker compose up
# --build` (shell values win over this file):
# APP_GIT_SHA=
# APP_GIT_REF=
# APP_BUILD_TIME=
# Compare against a different repository/branch only when deliberately needed.
PROJECT_REPOSITORY=NooboGreenD/ed-ring-colony
PROJECT_UPDATE_BRANCH=main
# Normally inferred from the Compose label; only needed with a custom agent hostname.
# MONITOR_COMPOSE_PROJECT=ed-ring-colony

# ── Manual project update (Админка → Мониторинг → «Обновление проекта») ──
# A private host-side agent is the only process allowed to run git pull + a
# rebuild. Enable it once: `sudo bash deploy/start-update-agent.sh`.
# UPDATE_AGENT_TOKEN is separate from CRON_SECRET and MONITOR_AGENT_TOKEN.
UPDATE_AGENT_TOKEN=
# Docker install: the updater runs as the `update-agent` service of the
# `monitoring` profile. A site without Docker should use http://127.0.0.1:8092
# (the host unit in deploy/ed-ring-colony-update.service).
UPDATE_AGENT_URL=http://update-agent:8092
# Host path of the git checkout: the updater container needs it mounted at the
# SAME path, because the Docker daemon resolves build contexts on the host.
# Written automatically by deploy/start-update-agent.sh and selfhost/install.sh.
# PROJECT_HOST_DIR=/opt/ed-ring-colony/src
# auto | compose | systemd — «auto» выбирает режим сам по наличию compose/unit.
PROJECT_DEPLOY_MODE=auto
# 1 — применять новые supabase/migrations/*.sql перед перезапуском.
# Дефолт для прогона задаётся здесь, но флажок в панели (Админка →
# Мониторинг → «Обновление проекта») перекрывает его на каждый запуск.
UPDATE_APPLY_MIGRATIONS=1
# Флажки панели обновления (значения здесь — только для ручного запуска
# скрипта; кнопки панели передают своё):
#   UPDATE_BACKUP_BEFORE=1  1 — pg_dump БД перед обновлением, 0 — без дампа
#   UPDATE_RUN_TESTS=1      1 — тесты при сборке, 0 — быстрый прогон без них
#   UPDATE_MIGRATIONS_ONLY  1 — только миграции, без сборки (редкий режим)
# Каталог клона на хосте, state/lock/журнал апдейта и проверка живости.
# PROJECT_DIR=/opt/ed-ring-colony/src
# UPDATE_STATE_DIR=/opt/ed-ring-colony/update-state
# UPDATE_HEALTH_URL=http://127.0.0.1:3000/api/health
# У полного обновления нет лимита времени: бэкап, тесты и холодная сборка
# могут суммарно идти несколько часов. Устаревшая UPDATE_TIMEOUT_MINUTES
# полностью игнорируется; старую строку UPDATE_TIMEOUT_MINUTES=45 можно удалить.
# После успешного обновления агент обычно сам перезапускается и подхватывает
# свой новый код. 0 отключает только автоматику: при предупреждении в панели
# останется кнопка «Перезапустить агент» (Docker/systemd поднимет его заново).
# UPDATE_AGENT_SELF_RESTART=1
# Задержка перед автоматическим или ручным перезапуском, чтобы панель успела
# получить ответ и финальный статус.
# UPDATE_AGENT_RESTART_DELAY_SECONDS=12

# ── Скорость docker-сборки образа web ────────────────────────────────
# 0 — пропустить npm test внутри образа (ускоренный режим). По умолчанию 1:
# проверки обязательны; ограничение времени полного обновления не применяется.
# RUN_TESTS=1

# ── Уборка диска после обновления ─────────────────────────────────────
# Каждая пересборка оставляет гигабайты кэша BuildKit (инвалидируется слой
# COPY — даже при правке в 3 КБ), и без уборки диск таял после каждого
# обновления. После успешного переключения контейнеров update-project.sh
# держит бюджет кэша сборки (свежие записи остаются — следующая сборка
# быстрая, старые копии срезаются). Формат как у docker: 8g, 512m…
# UPDATE_DOCKER_CACHE_KEEP=8g

# Бюджет кэш-МАУНТОВ BuildKit — /app/.next/cache и /root/.npm из Dockerfile
# web. Их НЕ подрезает docker builder prune (кэш-маунт — одна запись, всегда
# «самая свежая»; на части демонов она вообще не видна в docker system df).
# С Next 16.3 Turbopack по умолчанию пишет персистентный кэш сборки в
# .next/cache: без бюджета каждая переборка дописывала туда по 1–2 ГБ
# «в никуда». При превышении бюджета кэш-маунт вычищается целиком —
# следующая сборка будет «холодной» по этому кэшу. Формат как у docker.
# UPDATE_NEXT_CACHE_KEEP=2g
# UPDATE_NPM_CACHE_KEEP=2g

# Дамп БД перед обновлением (флажок «с бэкапом БД» в панели) по умолчанию
# НЕ включает каталог систем public.galaxy_systems — он весит десятки
# гигабайт и полностью восстанавливается импортом дампа Spansh (та же
# политика, что у ручного бэкапа). BACKUP_FULL=1 возвращает полную копию.
# BACKUP_FULL=0
# BACKUP_EXCLUDE_TABLE=public.galaxy_systems

# ── Страж свободного места перед сборкой образов ──────────────────────
# Сборка не стартует (и не ползёт часами до «DeadlineExceeded»), если на
# диске с Docker фактически свободно меньше порога. Перед отказом страж сам
# чистит кэш BuildKit и висячие образы и перепроверяет; поднять место
# руками можно командами `docker builder prune -af` и `docker image prune -f`.
# Формат как у docker: 4g, 512m… Порог 0 отключать НЕ рекомендуется —
# на переполненном диске BuildKit начинает ползать и сборка рвётся дедлайном.
# UPDATE_DOCKER_MIN_FREE=4g

# ── Автоповтор сорвавшейся сборки ─────────────────────────────────────
# Если compose build упал (сбой демона, сеть до Docker Hub, диск), скрипты
# обновления сами чистят остатки попытки и пробуют ещё раз — до N повторов.
# Кратковременный «DeadlineExceeded: context deadline exceeded» переживается
# без ручного перезапуска всего обновления. 0 — ретраи выключены, остатки
# сорвавшейся сборки всё равно вычищаются сразу (кэш failed-сборок диск
# больше не ест). Постоянная ошибка (упавший тест, синтаксис) как и раньше
# останавливает обновление последним кодом. Повторяется только упавший образ:
# образы собираются по одному (web — последним), поэтому падение web не
# заставляет заново собирать агентов.
# UPDATE_BUILD_RETRIES=2
# Пауза перед повтором, секунды: сразу после срыва демон ещё разгребает
# прерванную сборку, и мгновенный повтор попадает в ту же яму. 0 — без паузы.
# UPDATE_BUILD_RETRY_DELAY=20

# ── Переключение контейнеров после сборки ─────────────────────────────
# Сколько секунд ждать КОРРЕКТНОЙ остановки сервиса перед пересозданием.
# У docker/compose по умолчанию 10 с. На нагруженном диске web в них не
# укладывался, compose успевал уйти в переименование старого контейнера
# («<id>_src-web-1») на ещё живом контейнере, и создание нового падало:
#   Error when allocating new name: Conflict. The container name
#   "/src-web-1" is already in use by container "548bf76…"
# Обновление обрывалось кодом 1 уже ПОСЛЕ часовой успешной сборки, а
# оставшийся контейнер держал предыдущий образ web — поэтому image prune
# не возвращал его 1.5–3 ГБ, и диск таял «в никуда» каждую переборку.
# UPDATE_STOP_TIMEOUT=120
# Сколько раз повторить переключение, разобрав конфликт имени (снятие
# конфликтующего контейнера). 0 — без повторов.
# UPDATE_SWITCH_RETRIES=2
# UPDATE_SWITCH_RETRY_DELAY=5
# 0 — не останавливать сервисы явно перед `up -d` (поведение до исправления).
# UPDATE_PRESTOP=1

# ── Сборка без BuildKit (аварийный выключатель) ───────────────────────
# RUN --mount=type=cache в Dockerfile web понимает только BuildKit: compose
# без плагина buildx уходит в legacy-билдер и падает «the --mount option
# requires BuildKit». Скрипты обновления сами подставляют запасной Dockerfile
# без кэш-маунтов, когда BuildKit недоступен; этой переменной можно включить
# его принудительно — например, если демон Docker на хосте старше 20.10 и
# не тянет BuildKit-сборки, хотя плагин buildx установлен.
# EDRC_FORCE_LEGACY_BUILD=0

# ── Provenance-аттестации сборки ───────────────────────────────────────
# Buildx (BuildKit 0.11+) добавляет каждому образу provenance-аттестацию, а
# для её записи В КОНЦЕ сборки снова ходит в Docker Hub за манифестом
# базового образа («resolving provenance for metadata file»). Если канал до
# registry-1.docker.io нестабилен, этот шаг ронял всю сборку строкой
# «failed to solve: DeadlineExceeded: context deadline exceeded» — уже после
# того, как образы были собраны и экспортированы. Для локального стека
# аттестации ценности не имеют (образы никуда не пушатся), поэтому скрипты
# обновления и установки выключают их по умолчанию; 0 — вернуть аттестации.
# BUILDX_NO_DEFAULT_ATTESTATIONS=1

# ── Настройки почты из админ-панели (Админка → Авторизация) ───────────
# Письма подтверждения отправляет GoTrue (сервис auth стека Supabase), его
# SMTP-ключи живут в .env СТЕКА, а не сайта. Панель пишет их через
# update-agent — каталог стека должен быть виден агенту. Если агент уже
# работал в Docker, после первого обновления с этим docker-compose.yml один
# раз пересоздайте его контейнер:
#   docker compose --env-file .env.production --profile monitoring up -d --force-recreate update-agent
# SUPABASE_HOST_DIR=/opt/supabase

# ── Резервная копия базы (Админка → Бэкапы) ────────────────────────────
# Раз в неделю, только вручную: cron-расписания на сервере нет. Копию делает
# тот же update-agent (deploy/db-backup.sh), а на время дампа сайт показывает
# заглушку «Ведутся технические работы» (признак в public.app_flags).
# Каталог копий на хосте (должен быть примонтирован в update-agent).
UPDATE_BACKUP_DIR=/opt/ed-ring-colony/backups
# Сколько свежих копий хранить: 4 = месяц при еженедельном запуске.
UPDATE_BACKUP_KEEP=4
# Полный дамп (с каталогом систем на 10⁸ строк) идёт долго — запас по времени.
BACKUP_TIMEOUT_MINUTES=120
# Что исключать из обычной копии: каталог восстанавливается импортом дампа
# Spansh, а весит десятки гигабайт.
# BACKUP_EXCLUDE_TABLE=public.galaxy_systems

# Login/linking buttons (server runtime config). Google/GitHub are opt-in.
# Configure GoTrue separately in /opt/supabase/.env + auth compose override:
# deploy/selfhost/supabase-auth.override.yml, see POST-MIGRATION.md.
# OAuth client secrets belong in GoTrue, never NEXT_PUBLIC_* or the Uploader.
AUTH_OAUTH_PROVIDERS=discord
# Enable only after GoTrue SMTP + TokenHash email templates are configured.
# Existing password/OAuth logins do NOT depend on this flag.
AUTH_EMAIL_ENABLED=false

# Yandex Cloud Translate API v2 — автоперевод новостей и Galnet.
# Основной вариант — API-ключ сервисного аккаунта.
YANDEX_TRANSLATE_API_KEY=
# Альтернатива API-ключу (например, если используется IAM-токен).
YANDEX_TRANSLATE_IAM_TOKEN=
# Идентификатор каталога Yandex Cloud. Опционален, но обязателен
# при работе с глоссариями и для части аккаунтов.
YANDEX_TRANSLATE_FOLDER_ID=

# ── Frontier CAPI (досье пилота) ─────────────────────────────────────
# Авторизация идёт по PKCE, поэтому Shared Key от FDEV НЕ требуется:
# доказательством служит code_verifier, который знает только тот, кто начал
# авторизацию. Обязателен только redirect_uri.
#
# Полный адрес колбэка сайта, до символа:
FRONTIER_REDIRECT_URI=https://edringcolony.ru/api/capi/callback
#
# Client ID приложения CAPI. По умолчанию (пустое значение) используется ключ
# приложения «ED Ring Colony», зашитый в код: 0d6027a7-2561-4e1b-af2e-2fe71b296bdd
# Переопределяйте только для отдельного стенда со своим клиентом из
# Developer Zone (https://user.frontierstore.net → «CREATE CLIENT»).
FRONTIER_CLIENT_ID=0d6027a7-2561-4e1b-af2e-2fe71b296bdd
#
# НЕ нужен. Заполняйте только если осознанно используете «конфиденциальный»
# клиент с секретом: PKCE-поток от этого не сломается, но и работать без
# секрета продолжит.
FRONTIER_CLIENT_SECRET=
#
# Ключ подписи HttpOnly-cookie «этот поток начал вот этот пилот» (она нужна,
# чтобы привязка не сорвалась, если сессия сайта не доехала обратно с домена
# Frontier). Пустое значение — берётся SUPABASE_SERVICE_ROLE_KEY.
CAPI_STATE_SECRET=

# ── Web Push (уведомления) ──────────────────────────────────────────
# Пара VAPID-ключей: npx web-push generate-vapid-keys
# Публичный ключ вшивается в клиентский бандл, приватный — только сервер.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контакт владельца (mailto: или https:) для push-сервисов браузеров.
VAPID_SUBJECT=mailto:admin@example.com

# ── EDDN (рыночные данные, опционально) ──────────────────────────────
# Секрет, которым eddn-worker подписывает POST на /api/eddn/ingest.
EDDN_INGEST_SECRET=
# Куда воркер шлёт данные (адрес вашего сайта + /api/eddn/ingest).
EDDN_INGEST_URL=

# ── Прочие интеграции (опционально) ──────────────────────────────────
# Ключ Inara API (статистика пилотов).
INARA_API_KEY=
# Discord-вебхук для уведомлений.
DISCORD_WEBHOOK_URL=
# База Raven Colonial API, если отличается от значения по умолчанию.
RAVEN_API_BASE=

# Galnet sync (local jobs service; CLI scripts/galnet-sync.mjs is still available).
# Сколько последних статей забирать из ленты за один запуск.
GALNET_FEED_LIMIT=30
# Сколько статей переводить за один проход (остаток дойдёт следующим).
GALNET_TRANSLATE_LIMIT=10

# ── Биллинг: премиум-магазин, подписки, платежи ──────────────────────
# Хранилище биллинга: `supabase` (по умолчанию при наличии
# SUPABASE_SERVICE_ROLE_KEY; требует миграции supabase/migrations/2026092*_billing*)
# или `file` (data/billing_store.json — только для локальной разработки).
BILLING_STORAGE=
# Разрешить preview-администратора без входа (только для локальной отладки,
# в production игнорируется). 1 — включить.
BILLING_PREVIEW_ADMIN=
# Ключи платёжных систем (Т-Банк, ЮKassa, Robokassa, Stripe, CryptoBot, ручной перевод)
# вводятся в админ-панели: /admin?tab=billing → «Платёжные системы».
# Т-Банк: разовые платежи; инструкция и ограничения — TBANK-SETUP.md.
# Webhook-адреса: ${NEXT_PUBLIC_SITE_URL}/api/billing/webhooks/<provider>

# ── VK ID (вход через VK и привязка к профилю) ─────────────────────────
# Приложение создаётся на https://id.vk.com/about/business/go (тип «Web»).
# Redirect URI в настройках приложения: https://edringcolony.ru/api/auth/vk/callback
# Client ID — числовой ID приложения; секрет нужен только для confidential-приложений.
# Кнопка показывается только после включения в /admin → «Авторизация» (см. VK-ID-SETUP.md).
# Client ID можно ввести там же вместо env. Требует SUPABASE_SERVICE_ROLE_KEY.
VK_ID_CLIENT_ID=
VK_ID_CLIENT_SECRET=

# ── Яндекс ID (вход через Яндекс и привязка к профилю) ─────────────────
# Приложение создаётся на https://oauth.yandex.ru (платформа «Веб-сервисы»).
# Callback URI в настройках приложения: https://edringcolony.ru/api/auth/yandex/callback
# ClientID — 32 hex-символа; Client secret обязателен для веб-приложений.
# Кнопка показывается только после включения в /admin → «Авторизация» (см. YANDEX-ID-SETUP.md).
# ClientID/секрет можно ввести там же вместо env. Требует SUPABASE_SERVICE_ROLE_KEY.
YANDEX_ID_CLIENT_ID=
YANDEX_ID_CLIENT_SECRET=

# ── Канал обновлений Colonial Helper (десктопная программа) ────────────
# Программа обновляется не перекачиванием 22-мегабайтного exe, а пакетом
# кода: сервер отдаёт манифест версии и файлы по их sha256, а пилот качает
# только изменившиеся модули (обычно 5–130 КиБ). Подробности — в
# UPLOADER-UPDATE-STRUCTURE.md.
#
# Путь внутри web-контейнера. Не меняйте без необходимости.
UPLOADER_STORE_DIR=/data/uploader
# Путь НА ХОСТЕ. Здесь должны лежать все опубликованные версии, включая
# manifests, blobs, ZIP, базовый EXE, config.json и журналы процессов.
# По умолчанию — отдельная папка внутри каталога backup'ов (его обычно
# размещают на SDB). Если UPDATE_BACKUP_DIR изменён, задайте этот путь явно.
UPLOADER_STORE_HOST_DIR=/opt/ed-ring-colony/backups/uploader-releases
# Обычная публикация полностью настраивается в Админка → Обновления Helper:
# ключ хранится в закрытом config.json тома, исходники/EXE загружаются формой.
# Следующие значения нужны ТОЛЬКО для необязательной совместимости со старым
# внешним скриптом POST /api/admin/uploader/publish; GitHub Actions не нужны.
UPLOADER_PUBLISH_TOKEN=
# Дополнительные публичные ключи только для проверки внешних пакетов:
# "id:base64[,id2:base64]". Серверная пара настраивается из админки.
UPLOADER_SIGN_PUBLIC_KEYS=
# Переходный импорт старого приватного seed через env (предпочтительнее один
# раз импортировать его в панели и затем убрать эти значения из окружения).
UPLOADER_SIGN_KEY=
UPLOADER_SIGN_KEY_ID=
